{
    "compilerOptions": {
        "esModuleInterop": true,
        "skipLibCheck": true,
        "target": "es2022",
        "resolveJsonModule": true,
        "moduleDetection": "force",
        "isolatedModules": true,
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "moduleResolution": "Bundler",
        "module": "ES2022",
        "outDir": "dist",
        "sourceMap": true,
        "lib": ["es2022"]
    },
    "include": ["src"],
    "exclude": ["dist", "node_modules"]
}
