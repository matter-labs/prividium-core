{
    "compilerOptions": {
        "incremental": true,
        "tsBuildInfoFile": "./node_modules/.cache/tsconfig.tsbuildinfo",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "target": "es2022",
        "resolveJsonModule": true,
        "moduleDetection": "force",
        "isolatedModules": true,
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "moduleResolution": "Bundler",
        "module": "ES2022",
        "outDir": "dist",
        "rootDir": ".",
        "sourceMap": true,
        "lib": ["es2022"]
    }
}
