PORT=8000
SEQUENCER_RPC_URL=http://localhost:5050
TARGET_CHAIN_TYPE=zksync-os
DATABASE_URL=postgres://postgres:postgres@localhost:5432/prividium_api
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:5173
AUTH_METHODS=oidc,crypto_native
NODE_ENV=development
CORS_CACHE_DURATION_MS=60000# 1 min

SIWE_CHAIN_ID=6565
SIWE_VALID_DOMAINS=localhost:3000,localhost:3001
# Min 32 bytes hex-encoded. Generate with: openssl rand -hex 32
SIWE_HMAC_SECRET=aaaaaaaa00000000aaaaaaaa00000000aaaaaaaa00000000aaaaaaaa00000000
SIWE_CHALLENGE_RATE_LIMIT_COUNT=10
SIWE_CHALLENGE_RATE_LIMIT_WINDOW_SECONDS=300
SIWE_CONSUMED_NONCE_TTL_SECONDS=600
SIWE_CLEANUP_INTERVAL_SECONDS=60
# IPs to bypass the SIWE challenge rate limit (comma-separated).
SIWE_CHALLENGE_RATE_LIMIT_BYPASS_IPS=127.0.0.1,::1

# Deployment row lifecycle. Pending rows (sync deploy hit EIP-7966 timeout
# and tx never mined) get errored after the TTL. Errored rows are deleted
# after the retention window. Cleanup interval drives both sweeps.
DEPLOYMENT_PENDING_TTL_SECONDS=3600
DEPLOYMENT_ERRORED_RETENTION_SECONDS=604800
DEPLOYMENT_CLEANUP_INTERVAL_SECONDS=300

USER_SESSION_DURATION_SECONDS=3600
# Optional. Unset (default) = idle-timeout feature OFF; behavior is identical to today.
# When set: enables a sliding idle deadline on user web-app sessions; the user is logged
# out after this many seconds of inactivity. USER_SESSION_DURATION_SECONDS acts as the
# absolute cap — sessions are never extended beyond it regardless of activity.
# Must be ≤ USER_SESSION_DURATION_SECONDS (idle == cap is allowed).
# Keep it comfortably above the client extend cadence (5 minutes by default in both the SDK
# and the user panel) — clients only extend on that tick, so a shorter window logs out users
# who are actively working. 900 (15 minutes) is a sensible floor.
# Requires all client dApps to run the SDK version that ships session-extension support.
# USER_IDLE_TIMEOUT_SECONDS=1800
TENANT_SESSION_DURATION_SECONDS=3600
SERVICE_SESSION_DURATION_SECONDS=86400
HEALTH_CHECK_INTERVAL_MS=1000
DB_QUERY_TIMEOUT_MS=100000
DB_STATEMENT_TIMEOUT_MS=100000
DB_POOL_MAX_CONNECTIONS=10
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# OIDC Provider Configuration
# By default, this is configured for the local Keycloak dev instance
# For external providers (Okta, Auth0, etc.), update the values below with your provider's endpoints

# Local Keycloak (default)
OIDC_JWKS_URI=http://localhost:5080/realms/prividium/protocol/openid-connect/certs
OIDC_JWT_AUD=prividium-client
OIDC_JWT_ISSUER=http://localhost:5080/realms/prividium

# External OIDC Provider Example (Okta)
# OIDC_JWKS_URI=https://your-tenant.okta.com/oauth2/default/v1/keys
# OIDC_JWT_AUD=<your-okta-app-client-id>
# OIDC_JWT_ISSUER=https://your-tenant.okta.com/oauth2/default

# External OIDC Provider Example (Auth0)
#OIDC_JWKS_URI=https://your-tenant.us.auth0.com/.well-known/jwks.json
#OIDC_JWT_AUD=<your-auth0-app-client-id>
#OIDC_JWT_ISSUER=https://your-tenant.us.auth0.com/

# Admin User Configuration
# Comma-separated list of user "sub" claims from OIDC provider JWTs that should automatically get admin role
# Works with any OIDC provider (Keycloak, Okta, Auth0, etc.)
# Default: admin@local.dev user UUID from Keycloak realm export
# To add more admins: Find the user's "sub" claim from their JWT (decode at jwt.io or check browser DevTools)
OIDC_ADMIN_SUBS=00000000-0000-0000-0000-000000000001
# The address below is Anvil/Foundry's default test account #9 (public "test test test ...
# junk" mnemonic, path m/44'/60'/0'/0/9). Its private key is publicly known — never use this
# account or its key outside local anvil dev.
CRYPTO_NATIVE_ADMIN_WALLETS=0xa0Ee7A142d267C1f36714E4a8F75612F20a79720

# Security overrides
# Allowlist of dev EOAs that bypass the well-known dev wallet block.
# Production deployments MUST leave this empty (defaults to []).
# The addresses below are anvil/foundry defaults (m/44'/60'/0'/0/{0,1,2,3,4,9})
# used by the local dev seed data and the end-to-end test fixtures.
KNOWN_DEV_WALLETS_ALLOWLIST=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266,0x70997970C51812dc3A010C7d01b50e0d17dc79C8,0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC,0x90F79bf6EB2c4f870365E785982E1f101E93b906,0x15d34AAf54267DB7D7c367839AAf71A00a2C6A65,0xa0Ee7A142d267C1f36714E4a8F75612F20a79720

# Oauth redirect urls
ADMIN_PANEL_REDIRECT_URLS=http://localhost:3000/callback
BLOCK_EXPLORER_REDIRECT_URLS=http://localhost:3010/auth/callback
# Extra allowed redirect URLs for the Swagger UI (/docs) OAuth client, needed when the
# API is reachable via hostnames other than PRIVIDIUM_API_URL (comma-separated full
# callback URLs — exact match, no trailing slash). The request-derived
# <origin>/docs/callback is always allowed even when this is unset.
# SWAGGER_DOCS_REDIRECT_URLS=https://api.vanity-domain.com/docs/callback

# Swagger UI (/docs) access control.
# Comma-separated list of role ids permitted to view the Swagger UI after authenticating
# (the built-in zone admin role has the id "admin"). Set to "none" to disable the /docs endpoint entirely.
SWAGGER_UI_ALLOWED_ROLES=admin

LOG_LEVEL=debug

METRICS_PORT=9091

# Sentry configuration (sentry instance is not running locally so this is commented out)
# SENTRY_DSN=<dsn-url-for-sentry>
# SENTRY_ENVIRONMENT=<human readable env name like prividium-zksync-os-testnet>

# Bundler (ERC-4337) Configuration
# Set BUNDLER_ENABLED=true to enable bundler RPC methods
BUNDLER_ENABLED=false
# BUNDLER_RPC_URL=http://localhost:4337

# The Graph API
THE_GRAPH_API_ENABLED=false
THE_GRAPH_API_URL=

# Faucet: set FAUCET_ENABLED=true to serve /faucet and /admin/faucet endpoints.
# FAUCET_OPERATOR_PRIVATE_KEY is the key that signs claim transfers. The value below is
# Anvil's well-known account #0 test key (rich/pre-funded on the local anvil node). This key
# is PUBLIC and NEVER SAFE to use anywhere but local anvil dev — DO NOT deploy this value as-is.
# Before enabling the faucet in any shared or production environment, rotate to a freshly
# generated key managed by your secrets infra, and seed it out-of-band.
FAUCET_ENABLED=true
FAUCET_OPERATOR_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# Amount dispensed per successful claim (wei). 0.05 ETH shown here.
FAUCET_CLAIM_AMOUNT_WEI=50000000000000000
# Min seconds between successful claims for the same user.
FAUCET_COOLDOWN_SECONDS=86400
# Seconds after which a stranded `pending` claim row is treated as stale and auto-failed
# (lets the user retry after a crash). Should comfortably exceed worst-case tx confirm time.
FAUCET_STALE_PENDING_SECONDS=3600
# Rolling 24h cap on total successful claim sum (wei). Set to 0 to disable the cap.
FAUCET_MAX_DAILY_SPEND_WEI=5000000000000000000
# Max time to wait for receipt after submitting the claim tx (ms).
FAUCET_TX_TIMEOUT_MS=30000

# SSO Smart Account Dispatcher Configuration (optional)
# Used for verifying smart account proxy contracts
# DISPATCHER_SSO_BYTECODE_HASHES=<comma-separated bytecode hashes>
# DISPATCHER_SSO_IMPLEMENTATIONS=<comma-separated implementation addresses>

WALLETS_API_ENABLED=true

# Tenants feature (admin tenant management, tenant SIWE/API-key auth, tenant RPC target).
# Default: false. Set to true only if your deployment still relies on tenant integrations.
TENANTS_ENABLED=false

# Selective disclosure RPC methods (prividium_*Disclosure).
# When false (default), all four methods are unregistered and calls return "Method ... not found".
# Disabled by default: eth_call-based disclosures (token supply/balance) can be forged by a
# malicious contract deployer.
DISCLOSURE_METHODS_ENABLED=false

# Brand name shown in user-facing strings (SIWE wallet prompts, Swagger UI).
BRAND_NAME=Prividium™

# Multi-organization support (per-org OIDC, org-scoped roles/contracts/M2M, branding).
# When false (default), all multi-org behavior is gated off and single-org/zone behavior is unchanged.
# Only /judge authorizes the inner call frames of a transaction, so POLICY_PORT is required
# alongside this: without it an organization reaches another organization through any contract
# that forwards calls. Dev and CI stacks set INSECURE_MULTI_ORG_WITHOUT_POLICY_ENABLED instead.
MULTI_ORG_ENABLED=false

# When true, organizations are bound to their serving domain (ingress-stamped X-Org-Id): panels ignore
# the `?org=` URL selector and the zone domain never serves an org login. Leave false for local dev and
# single-domain deployments, which select the org via `?org=`.
ORG_ROUTING_BY_DOMAIN=false

# Maximum number of organizations that may exist; POST /organizations rejects creation past this.
MAX_ORGANIZATIONS=100
# Maximum number of wallets that may be associated with a single user; wallet-adding endpoints reject past this.
MAX_WALLETS_PER_USER=100
# Caps how deep GET /audit-logs can be paged
AUDIT_LOGS_PAGINATION_MAX_ITEMS=10000

# INSECURE, testnet-only: lets M2M apps whitelist allow-all CIDRs (0.0.0.0/0, ::/0) by
# disabling the broad-CIDR guard for M2M IP whitelist writes. Never enable on mainnet.
# When false (default), CIDRs broader than /16 (IPv4) or /32 (IPv6) are rejected.
INSECURE_M2M_ALLOW_ANY_IP_ENABLED=false

# INSECURE, dev and CI only: lets MULTI_ORG_ENABLED=true boot with no POLICY_PORT, leaving the
# inner call frames of every transaction unauthorized. Set it only where the sequencer has no
# policy protocol to call /judge with. Never set it on a deployed environment.
INSECURE_MULTI_ORG_WITHOUT_POLICY_ENABLED=false

# Webauthn configuration
WEBAUTHN_RP_NAME=ZKsync Prividium
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3001,http://localhost:3000
WEBAUTHN_REQUIRE_USER_VERIFICATION=false
# Restrict passkey registration to a specific authenticator type.
# 'platform' = device-native only (Touch ID, Windows Hello) — strongest hardware binding.
# 'cross-platform' = roaming authenticators only (1Password, Bitwarden, YubiKey).
# Unset (default) = allow both.
WEBAUTHN_AUTHENTICATOR_ATTACHMENT=platform

# Default fee collector address for zksyncos
EXTRA_PUBLIC_CODE_ADDRESSES=0x36615Cf349d7F6344891B1e7CA7C72883F5dc049

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_MAX=100
RATE_LIMIT_PUBLIC_MAX=300
RATE_LIMIT_USER_MAX=300
RATE_LIMIT_RPC_MAX=1000
RATE_LIMIT_M2M_MAX=1000
RATE_LIMIT_WINDOW_MS=60000

# App configuration
VERSION=local-dev
PRIVIDIUM_API_URL=http://localhost:8000
BLOCK_EXPLORER_URL=http://localhost:3010
USER_PANEL_URL=http://localhost:3001
CHAIN_NAME="Prividium™ Local"
NATIVE_TOKEN_NAME=Ether
NATIVE_TOKEN_SYMBOL=ETH
NATIVE_TOKEN_DECIMALS=18
L1_CHAIN_ID=31337
L1_CHAIN_NAME="Anvil Localhost"
# L1 address of the native token. Set this only when the chain uses a custom
# base token (not ETH). Unset → emitted as null on /.well-known/prividium.
# NATIVE_TOKEN_L1_ADDRESS=0x0000000000000000000000000000000000000000
# Narrows which wallets the user panel features in its connect picker
# (EIP-6963 rdns values). Omit to feature the panel's full wallet registry.
# Curation only — any wallet can still connect via WalletConnect.
# FEATURED_WALLET_IDS=io.metamask,io.rabby

# TxValidator policy service (POST /admit, POST /judge)
# Comma-separated list of opaque protocol versions accepted from the
# sequencer. A request whose protocolVersion is in this set is processed
# normally; anything else returns ruleId=protocol.version_mismatch.
# Carrying multiple versions here lets prividium and the server roll
# independently — bump prividium to "v_old,v_new", flip the server, then
# drop v_old. The first entry is the preferred version, advertised on
# responses to requests whose version isn't supported.
POLICY_PROTOCOL_VERSIONS=1
# Bearer-token listener for /admit and /judge. Leave POLICY_PORT unset to
# disable the policy listener entirely (tests / non-Prividium deploys); any
# deployment with MULTI_ORG_ENABLED=true must set it.
# POLICY_AUTH_TOKEN is the static shared secret the sequencer sends as
# `Authorization: Bearer <token>`. It is required whenever POLICY_PORT is set:
# an unauthenticated /admit answers whether an arbitrary transaction would be
# allowed, to anyone who can reach the port.
# Any free port works; 8010 below just avoids colliding with PORT.
# POLICY_PORT=8010
# POLICY_AUTH_TOKEN=changeme

# In-memory read-through cache for /admit and /judge decisions. The same tx is
# evaluated at mempool inclusion and again at block building, so the repeat is a
# guaranteed hit. Invalidation is TTL-only: a permission change is reflected
# after the entry TTL elapses.
# POLICY_DECISION_CACHE_ENABLED=false
# POLICY_DECISION_CACHE_TTL_MS=30000
# POLICY_DECISION_CACHE_MAX_ENTRIES=50000
