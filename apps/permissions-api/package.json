{
    "name": "@repo/permissions-api",
    "version": "0.0.0",
    "description": "Permissions API for zksync-prividium",
    "type": "module",
    "exports": {
        "./src/build-app": "./src/build-app.ts",
        "./src/build-policy-app": "./src/build-policy-app.ts",
        "./src/core-facts/repositories-core-facts": "./src/core-facts/repositories-core-facts.ts",
        "./src/db": "./src/db/index.ts",
        "./src/db/repositories": "./src/db/repositories.ts",
        "./src/db/schema": "./src/db/schema.ts",
        "./src/env": "./src/env.ts",
        "./src/index": "./src/index.ts",
        "./src/middleware/api-key-auth": "./src/middleware/api-key-auth.ts",
        "./src/permissions/system-permissions": "./src/permissions/system-permissions.ts",
        "./src/repositories/audit-logs-repository": "./src/repositories/audit-logs-repository.ts",
        "./src/repositories/roles-repository": "./src/repositories/roles-repository.ts",
        "./src/repositories/sessions-repository": "./src/repositories/sessions-repository.ts",
        "./src/rpc/constants": "./src/rpc/constants.ts",
        "./src/rpc/json-rpc": "./src/rpc/json-rpc.ts",
        "./src/rpc/methods/base-rpc-method-list": "./src/rpc/methods/base-rpc-method-list.ts",
        "./src/services/api-key-service": "./src/services/api-key-service.ts",
        "./src/services/audit-logs-service": "./src/services/audit-logs-service.ts",
        "./src/services/session-service": "./src/services/session-service.ts",
        "./src/services/siwe-service": "./src/services/siwe-service.ts",
        "./src/utils/abi": "./src/utils/abi.ts",
        "./src/utils/metrics": "./src/utils/metrics.ts",
        "./src/utils/recover-tx-address-native": "./src/utils/recover-tx-address-native.ts",
        "./src/utils/schemas/fastify-common": "./src/utils/schemas/fastify-common.ts",
        "./src/services/system-contracts/registry": "./src/services/system-contracts/registry.ts",
        "./src/services/system-contracts/sync": "./src/services/system-contracts/sync.ts",
        "./src/routes/regular-rpc-routes": "./src/routes/regular-rpc-routes.ts",
        "./src/routes/rpc-transport": "./src/routes/rpc-transport.ts",
        "./src/rpc/target-rpc": "./src/rpc/target-rpc.ts",
        "./src/rpc/permissions/authorizer": "./src/rpc/permissions/authorizer.ts"
    },
    "scripts": {
        "start": "node dist/index.js",
        "build": "tsx esbuild.ts",
        "build:watch": "tsx esbuild.ts --watch",
        "dev": "tsx watch src/main.ts | pino-pretty",
        "start:e2e": "NODE_ENV=production dotenv -e .env -- pnpm start",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "typecheck": "tsc --noEmit",
        "db:migrate": "drizzle-kit migrate",
        "db:seed": "tsx scripts/seed.ts",
        "db:generate": "drizzle-kit generate && biome format --write ./drizzle",
        "db:drop": "drizzle-kit drop",
        "db:studio": "drizzle-kit studio",
        "verify-config": "tsx -r dotenv/config check-env.ts",
        "export-openapi-spec": "tsx scripts/export-open-api-spec.ts"
    },
    "dependencies": {
        "@fastify/cookie": "^11.0.2",
        "@fastify/cors": "^10.0.1",
        "@fastify/http-proxy": "^11.4.4",
        "@fastify/rate-limit": "^10.3.0",
        "@fastify/schedule": "^6.0.0",
        "@fastify/swagger": "^9.5.1",
        "@fastify/swagger-ui": "^6.1.1",
        "@repo/access-control": "workspace:*",
        "@repo/api-kit": "workspace:*",
        "@repo/api-metrics": "workspace:*",
        "@repo/prividium-sdk": "workspace:*",
        "@sentry/node": "^8.45.0",
        "@simplewebauthn/server": "^13.1.1",
        "@t3-oss/env-core": "^0.13.11",
        "abitype": "^1.2.3",
        "close-with-grace": "^2.1.0",
        "date-fns": "^4.1.0",
        "dotenv": "^16.4.5",
        "drizzle-orm": "^0.45.2",
        "drizzle-zod": "^0.8.3",
        "fastify": "^5.12.1",
        "fastify-type-provider-zod": "^6.1.0",
        "ipaddr.js": "^2.3.0",
        "jose": "^6.0.11",
        "nanoid": "^5.1.16",
        "permix": "^3.5.0",
        "pg": "^8.13.1",
        "pino": "^9.9.5",
        "prom-client": "^15.1.0",
        "secp256k1": "^5.0.1",
        "toad-scheduler": "^3.1.0",
        "viem": "^2.30.4",
        "zod": "^4.3.5"
    },
    "devDependencies": {
        "@repo/test-deps": "workspace:*",
        "@sentry/cli": "^3.2.0",
        "@types/node": "^25.6.0",
        "@types/pg": "^8.23.1",
        "@types/secp256k1": "^4.0.7",
        "@types/supertest": "^6.0.3",
        "@vitest/coverage-v8": "5.0.0",
        "@vitest/runner": "^3.2.6",
        "@vitest/ui": "^3.2.6",
        "drizzle-kit": "0.31.10",
        "esbuild": "^0.25.0",
        "esbuild-node-externals": "^1.15.0",
        "pino-pretty": "^13.0.0",
        "supertest": "^7.1.1",
        "tsx": "^4.19.1",
        "typescript": "^5.8.3",
        "vitest": "^3.2.6"
    }
}
