{
    "name": "prividium-core",
    "version": "0.1.0",
    "private": true,
    "license": "Apache-2.0",
    "scripts": {
        "dev": "turbo run dev --filter @repo/permissions-api",
        "build": "turbo run build",
        "typecheck": "turbo typecheck",
        "test": "vitest run",
        "biome": "biome check --write --config-path=./biome.config.json",
        "biome:check": "biome check --error-on-warnings --config-path=./biome.config.json",
        "fmt:md": "prettier --write --cache --log-level=warn \"**/*.md\"",
        "fmt:md:check": "prettier --cache --check \"**/*.md\""
    },
    "description": "Permissioned RPC proxy and permissions API for ZKsync networks",
    "packageManager": "pnpm@10.28.1",
    "devDependencies": {
        "@biomejs/biome": "^2.4.4",
        "@vitest/coverage-v8": "5.0.0",
        "prettier": "^3.6.2",
        "tsx": "^4.22.4",
        "turbo": "^2.9.18",
        "vitest": "^3.2.6"
    }
}
