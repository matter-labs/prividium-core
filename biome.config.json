{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true,
            "style": {
                "noNonNullAssertion": "off"
            },
            "correctness": {
                "noUnusedImports": {
                    "level": "warn",
                    "fix": "safe"
                }
            }
        }
    },
    "assist": {
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "trailingCommas": "none",
            "bracketSpacing": true
        }
    },
    "json": {
        "formatter": {
            "indentWidth": 4
        }
    },
    "overrides": [
        {
            "includes": ["**/.releaserc.js", "**/.releaserc.cjs"],
            "linter": {
                "rules": {
                    "suspicious": {
                        "noTemplateCurlyInString": "off"
                    }
                }
            }
        }
    ]
}
